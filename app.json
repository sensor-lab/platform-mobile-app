{
  "expo": {
    "name": "sensorsparks-mobile-app",
    "slug": "sensorsparks-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash_icon_220_220_background.png",
    "scheme": "sensorsparksmobileapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devcognitivetpg.sensorsparksmobileapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/splash_icon_220_220_background.png",
        "backgroundImage": "./assets/images/splash_icon_220_220_background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.devcognitivetpg.sensorsparksmobileapp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash/splash_icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#FFFFFF"
        }
      ]
      // "expo-build-properties",
      // {
      //   "ios": {
      //     "networkInspector": false
      //   }
      // }
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
